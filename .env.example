# Vorlage – hier stehen KEINE echten Schlüssel.
#
# Lokal: Datei nach `.env.local` kopieren und die Werte aus dem Clerk-
# Dashboard eintragen (.env.local ist über .gitignore ausgeschlossen).
# Produktion/Preview: dieselben Variablen in den Vercel-Projekt-
# einstellungen unter „Environment Variables" hinterlegen.

# Öffentlich – landet im Browser-Bundle, das ist bei Clerk so vorgesehen.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GEHEIM – darf niemals in den Quellcode, ins Repository oder in den Browser.
CLERK_SECRET_KEY=sk_test_dein_schluessel_hier

# Erster Administrator – Henne-Ei-Problem beim Aufsetzen.
# Kommagetrennte E-Mail-Adressen, die immer als Admin gelten, auch ohne
# gesetzte publicMetadata.rolle. Danach vergibt der Admin Rollen in Clerk;
# diese Liste kann klein bleiben oder ganz verschwinden.
AUFMASSX_ADMIN_EMAILS=

# Routen der Anmeldung. Müssen zu app/sign-in bzw. app/sign-up passen.
# /sign-up zeigt nur mit gültigem Einladungs-Ticket ein Formular – AufmaßX
# ist eine interne Anwendung ohne öffentliche Registrierung.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# ── Einladungscodes ─────────────────────────────────────────────────────────
# Einmalcodes brauchen einen serverseitigen, dauerhaften Speicher. Auf Vercel:
# Storage → Neon (Postgres) anlegen, dann steht DATABASE_URL automatisch im
# Projekt. Danach einmal db/schema.sql ausführen.
DATABASE_URL=postgresql://benutzer:passwort@host.neon.tech/datenbank?sslmode=require

# GEHEIM. Schlüssel für den HMAC über die Einladungscodes. Ohne ihn lässt sich
# aus der Datenbank allein kein gültiger Code ableiten. Mindestens 16 Zeichen,
# am besten so erzeugt:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# ACHTUNG: Wird er geändert, sind alle bestehenden Codes ungültig.
EINLADUNG_PEPPER=
